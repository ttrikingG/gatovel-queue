{
    "name": "gatovel/queue",
    "description": "Sistema de filas e processamento de jobs para aplicações PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Gatovel\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gatovel\\Queue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
